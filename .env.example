# ==============================================================================
# SismoWatch - Environment Variables Configuration Template
# Copy this file to .env and configure secrets prior to starting docker compose:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_this_airflow_postgres_password_2026
POSTGRES_DB=sismowatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=5433

# Dedicated read-only API DB user (least privilege: only accesses 'curated' schema)
API_DB_USER=sismowatch_api
API_DB_PASSWORD=change_this_api_secret_password_2026

# ------------------------------------------------------------------------------
# 2. Apache Airflow Configuration
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
# Fernet key generated using cryptography.fernet.Fernet.generate_key()
AIRFLOW__CORE__FERNET_KEY=efVAw1SDYe4YVL6oTlLOJCRsa6nHnAinxHC6jD7e82E=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__ENABLE_XCOM_PICKLING=False
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=1
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False

# Airflow Admin UI Credentials (Non-default credentials)
_AIRFLOW_WWW_USER_USERNAME=sismowatch_admin
_AIRFLOW_WWW_USER_PASSWORD=AirflowAdmin2026!Secure

AIRFLOW_PORT=8080

# ------------------------------------------------------------------------------
# 3. FastAPI Backend Configuration
# ------------------------------------------------------------------------------
API_PORT=8000
SECRET_KEY=sismowatch_jwt_super_secret_production_key_32bytes_min_2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Platform Initial User Credentials (Seeded into curated.users)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=viewer123

# CORS Configuration (Restricted to frontend origin)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. AI & LLM Provider Configuration
# Supported providers: gemini | openai | ollama | fallback
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://host.docker.internal:11434
AI_MODEL_NAME=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 5. Frontend Platform Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 6. Observability & Alerts (Optional webhooks)
# ------------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
ALERT_EMAIL_RECIPIENT=devops@sismowatch.internal
